[
  // ─────────────────────────────────────────────────────────────────────────
  // SETUP
  // ─────────────────────────────────────────────────────────────────────────
  {
    "label": "Setup: Install all dependencies",
    "command": "pip",
    "args": ["install", "-e", ".[dev]"],
    "cwd": "$ZED_WORKTREE_ROOT",
    "use_new_terminal": false,
    "allow_concurrent_runs": false,
    "reveal": "always",
    "tags": ["build"],
  },
  {
    "label": "Setup: Install pre-commit hooks",
    "command": "pre-commit",
    "args": ["install"],
    "cwd": "$ZED_WORKTREE_ROOT",
    "use_new_terminal": false,
    "allow_concurrent_runs": false,
    "reveal": "always",
    "tags": ["build"],
  },
  {
    "label": "Setup: Install debugpy",
    "command": "pip",
    "args": ["install", "debugpy"],
    "cwd": "$ZED_WORKTREE_ROOT",
    "use_new_terminal": false,
    "allow_concurrent_runs": false,
    "reveal": "always",
    "tags": ["build"],
  },

  // ─────────────────────────────────────────────────────────────────────────
  // TEST
  // ─────────────────────────────────────────────────────────────────────────
  {
    "label": "Test: Run all tests",
    "command": "python",
    "args": ["-m", "pytest", "tests/", "-v"],
    "env": {
      "PYTHONPATH": "$ZED_WORKTREE_ROOT/src",
    },
    "cwd": "$ZED_WORKTREE_ROOT",
    "use_new_terminal": false,
    "allow_concurrent_runs": false,
    "reveal": "always",
    "tags": ["test"],
  },
  {
    "label": "Test: Run with coverage",
    "command": "python",
    "args": [
      "-m",
      "pytest",
      "tests/",
      "-v",
      "--cov=bci_dapp",
      "--cov-report=term-missing",
      "--cov-report=html:htmlcov",
    ],
    "env": {
      "PYTHONPATH": "$ZED_WORKTREE_ROOT/src",
    },
    "cwd": "$ZED_WORKTREE_ROOT",
    "use_new_terminal": false,
    "allow_concurrent_runs": false,
    "reveal": "always",
    "tags": ["test"],
  },
  {
    "label": "Test: Run current file",
    "command": "python",
    "args": ["-m", "pytest", "$ZED_FILE", "-v"],
    "env": {
      "PYTHONPATH": "$ZED_WORKTREE_ROOT/src",
    },
    "cwd": "$ZED_WORKTREE_ROOT",
    "use_new_terminal": false,
    "allow_concurrent_runs": false,
    "reveal": "always",
    "tags": ["test"],
  },
  {
    "label": "Test: Run current file (fail-fast)",
    "command": "python",
    "args": ["-m", "pytest", "$ZED_FILE", "-v", "-x"],
    "env": {
      "PYTHONPATH": "$ZED_WORKTREE_ROOT/src",
    },
    "cwd": "$ZED_WORKTREE_ROOT",
    "use_new_terminal": false,
    "allow_concurrent_runs": false,
    "reveal": "always",
    "tags": ["test"],
  },
  {
    "label": "Test: EEG Simulator",
    "command": "python",
    "args": ["-m", "pytest", "tests/test_eeg_simulator.py", "-v"],
    "env": {
      "PYTHONPATH": "$ZED_WORKTREE_ROOT/src",
    },
    "cwd": "$ZED_WORKTREE_ROOT",
    "use_new_terminal": false,
    "allow_concurrent_runs": false,
    "reveal": "always",
    "tags": ["test"],
  },
  {
    "label": "Test: LLM Agent",
    "command": "python",
    "args": ["-m", "pytest", "tests/test_llm_agent.py", "-v"],
    "env": {
      "PYTHONPATH": "$ZED_WORKTREE_ROOT/src",
    },
    "cwd": "$ZED_WORKTREE_ROOT",
    "use_new_terminal": false,
    "allow_concurrent_runs": false,
    "reveal": "always",
    "tags": ["test"],
  },
  {
    "label": "Test: Provenance & Ledger",
    "command": "python",
    "args": ["-m", "pytest", "tests/test_provenance_ledger.py", "-v"],
    "env": {
      "PYTHONPATH": "$ZED_WORKTREE_ROOT/src",
    },
    "cwd": "$ZED_WORKTREE_ROOT",
    "use_new_terminal": false,
    "allow_concurrent_runs": false,
    "reveal": "always",
    "tags": ["test"],
  },
  {
    "label": "Test: Run last failed",
    "command": "python",
    "args": ["-m", "pytest", "--last-failed", "-v"],
    "env": {
      "PYTHONPATH": "$ZED_WORKTREE_ROOT/src",
    },
    "cwd": "$ZED_WORKTREE_ROOT",
    "use_new_terminal": false,
    "allow_concurrent_runs": false,
    "reveal": "always",
    "tags": ["test"],
  },
  {
    "label": "Test: Show coverage report (HTML)",
    "command": "python",
    "args": ["-m", "http.server", "8080", "--directory", "htmlcov"],
    "cwd": "$ZED_WORKTREE_ROOT",
    "use_new_terminal": true,
    "allow_concurrent_runs": false,
    "reveal": "always",
  },

  // ─────────────────────────────────────────────────────────────────────────
  // LINT & FORMAT
  // ─────────────────────────────────────────────────────────────────────────
  {
    "label": "Lint: Ruff check",
    "command": "python",
    "args": ["-m", "ruff", "check", "src/", "tests/"],
    "cwd": "$ZED_WORKTREE_ROOT",
    "use_new_terminal": false,
    "allow_concurrent_runs": false,
    "reveal": "always",
    "tags": ["build"],
  },
  {
    "label": "Lint: Ruff check --fix",
    "command": "python",
    "args": ["-m", "ruff", "check", "--fix", "src/", "tests/"],
    "cwd": "$ZED_WORKTREE_ROOT",
    "use_new_terminal": false,
    "allow_concurrent_runs": false,
    "reveal": "always",
    "tags": ["build"],
  },
  {
    "label": "Lint: Ruff format",
    "command": "python",
    "args": ["-m", "ruff", "format", "src/", "tests/"],
    "cwd": "$ZED_WORKTREE_ROOT",
    "use_new_terminal": false,
    "allow_concurrent_runs": false,
    "reveal": "always",
    "tags": ["build"],
  },
  {
    "label": "Lint: Ruff format --check",
    "command": "python",
    "args": ["-m", "ruff", "format", "--check", "src/", "tests/"],
    "cwd": "$ZED_WORKTREE_ROOT",
    "use_new_terminal": false,
    "allow_concurrent_runs": false,
    "reveal": "always",
    "tags": ["build"],
  },
  {
    "label": "Lint: Ruff check current file",
    "command": "python",
    "args": ["-m", "ruff", "check", "$ZED_FILE"],
    "cwd": "$ZED_WORKTREE_ROOT",
    "use_new_terminal": false,
    "allow_concurrent_runs": true,
    "reveal": "always",
    "tags": ["build"],
  },
  {
    "label": "Type: Mypy src/",
    "command": "python",
    "args": ["-m", "mypy", "src/"],
    "env": {
      "PYTHONPATH": "$ZED_WORKTREE_ROOT/src",
    },
    "cwd": "$ZED_WORKTREE_ROOT",
    "use_new_terminal": false,
    "allow_concurrent_runs": false,
    "reveal": "always",
    "tags": ["build"],
  },
  {
    "label": "Type: Mypy current file",
    "command": "python",
    "args": ["-m", "mypy", "$ZED_FILE"],
    "env": {
      "PYTHONPATH": "$ZED_WORKTREE_ROOT/src",
    },
    "cwd": "$ZED_WORKTREE_ROOT",
    "use_new_terminal": false,
    "allow_concurrent_runs": true,
    "reveal": "always",
    "tags": ["build"],
  },
  {
    "label": "Lint: Pre-commit run all",
    "command": "pre-commit",
    "args": ["run", "--all-files"],
    "cwd": "$ZED_WORKTREE_ROOT",
    "use_new_terminal": false,
    "allow_concurrent_runs": false,
    "reveal": "always",
    "tags": ["build"],
  },

  // ─────────────────────────────────────────────────────────────────────────
  // RUN - CLI pipeline
  // ─────────────────────────────────────────────────────────────────────────
  {
    "label": "Run: BCI pipeline (5 sessions)",
    "command": "python",
    "args": ["-m", "bci_dapp.cli", "--n", "5"],
    "env": {
      "PYTHONPATH": "$ZED_WORKTREE_ROOT/src",
      "LOG_LEVEL": "INFO",
    },
    "cwd": "$ZED_WORKTREE_ROOT",
    "use_new_terminal": true,
    "allow_concurrent_runs": false,
    "reveal": "always",
    "tags": ["run"],
  },
  {
    "label": "Run: BCI pipeline (10 sessions)",
    "command": "python",
    "args": ["-m", "bci_dapp.cli", "--n", "10"],
    "env": {
      "PYTHONPATH": "$ZED_WORKTREE_ROOT/src",
      "LOG_LEVEL": "INFO",
    },
    "cwd": "$ZED_WORKTREE_ROOT",
    "use_new_terminal": true,
    "allow_concurrent_runs": false,
    "reveal": "always",
    "tags": ["run"],
  },
  {
    "label": "Run: BCI pipeline + export ledger",
    "command": "python",
    "args": ["-m", "bci_dapp.cli", "--n", "5", "--export"],
    "env": {
      "PYTHONPATH": "$ZED_WORKTREE_ROOT/src",
      "LOG_LEVEL": "INFO",
    },
    "cwd": "$ZED_WORKTREE_ROOT",
    "use_new_terminal": true,
    "allow_concurrent_runs": false,
    "reveal": "always",
    "tags": ["run"],
  },
  {
    "label": "Run: BCI pipeline (LLM mode)",
    "command": "python",
    "args": ["-m", "bci_dapp.cli", "--n", "5", "--llm"],
    "env": {
      "PYTHONPATH": "$ZED_WORKTREE_ROOT/src",
      "LOG_LEVEL": "DEBUG",
    },
    "cwd": "$ZED_WORKTREE_ROOT",
    "use_new_terminal": true,
    "allow_concurrent_runs": false,
    "reveal": "always",
    "tags": ["run"],
  },
  {
    "label": "Run: BCI pipeline (DEBUG logging)",
    "command": "python",
    "args": ["-m", "bci_dapp.cli", "--n", "5"],
    "env": {
      "PYTHONPATH": "$ZED_WORKTREE_ROOT/src",
      "LOG_LEVEL": "DEBUG",
    },
    "cwd": "$ZED_WORKTREE_ROOT",
    "use_new_terminal": true,
    "allow_concurrent_runs": false,
    "reveal": "always",
    "tags": ["run"],
  },

  // ─────────────────────────────────────────────────────────────────────────
  // INSPECT - module-level quick checks
  // ─────────────────────────────────────────────────────────────────────────
  {
    "label": "Inspect: Print package version",
    "command": "python",
    "args": ["-c", "import bci_dapp; print(bci_dapp.__version__)"],
    "env": {
      "PYTHONPATH": "$ZED_WORKTREE_ROOT/src",
    },
    "cwd": "$ZED_WORKTREE_ROOT",
    "use_new_terminal": false,
    "allow_concurrent_runs": true,
    "reveal": "always",
  },
  {
    "label": "Inspect: Show ledger chain",
    "command": "python",
    "args": [
      "-c",
      "import json, pathlib; p=pathlib.Path('data/ledger.json'); print(json.dumps(json.loads(p.read_text()), indent=2)) if p.exists() else print('No ledger at data/ledger.json')",
    ],
    "env": {
      "PYTHONPATH": "$ZED_WORKTREE_ROOT/src",
    },
    "cwd": "$ZED_WORKTREE_ROOT",
    "use_new_terminal": false,
    "allow_concurrent_runs": true,
    "reveal": "always",
  },
  {
    "label": "Inspect: Generate EEG frame (smoke test)",
    "command": "python",
    "args": [
      "-c",
      "from bci_dapp.eeg_simulator import EEGSimulator; s=EEGSimulator(seed=0); f=s.generate_frame(); print('dominant:', f.dominant_band, '| snr:', f.snr_db, 'dB'); print('bands:', {k: round(v,3) for k,v in f.band_mean.items()})",
    ],
    "env": {
      "PYTHONPATH": "$ZED_WORKTREE_ROOT/src",
    },
    "cwd": "$ZED_WORKTREE_ROOT",
    "use_new_terminal": false,
    "allow_concurrent_runs": true,
    "reveal": "always",
  },
  {
    "label": "Inspect: Generate keypair (smoke test)",
    "command": "python",
    "args": [
      "-c",
      "from bci_dapp.provenance import ProvenanceManager; kp=ProvenanceManager().generate_keypair(); print('pub :', kp['public_key'][:32], '...'); print('priv:', kp['private_key'][:16], '... [KEEP SECRET]')",
    ],
    "env": {
      "PYTHONPATH": "$ZED_WORKTREE_ROOT/src",
    },
    "cwd": "$ZED_WORKTREE_ROOT",
    "use_new_terminal": false,
    "allow_concurrent_runs": true,
    "reveal": "always",
  },
]
