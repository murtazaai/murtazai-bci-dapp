# Copy this file to .env and fill in real values.
# .env is in .gitignore - never commit real secrets.

APP_NAME=murtazai-bci-dapp
APP_DEBUG=false
LOG_LEVEL=INFO

# LLM / rig-core endpoint
# For local rig-core / Ollama: http://localhost:11434/v1
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
OPENAI_API_KEY=sk-...

# EEG simulator
EEG_SAMPLING_RATE=256
EEG_WINDOW_SEC=2.0

# Ledger persistence path
LEDGER_PATH=data/ledger.json
